# ClipForge configuration. Copy to .env and edit.
# Nothing here is required to run locally -- the defaults boot a working
# instance with uploads as the only content source.

ENV=development
DEBUG=true
PUBLIC_URL=http://localhost:8000

# Sign your session tokens. MUST be set in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
TOKEN_HOURS=336

# SQLite by default. Point at Postgres for anything real:
#   DATABASE_URL=postgresql+psycopg://user:pass@host/clipforge
DATABASE_URL=
STORAGE_DIR=

# ---- Content sources -------------------------------------------------------
# ONLY sources licensed for commercial reuse are listed here. This is what
# makes the product's copyright promise true rather than aspirational.
#   upload  - the user's own footage (no rights question at all)
#
# The stock and open-collection adapters (Pexels, Pixabay, Openverse and the
# Internet Archive) were removed. They held no broadcast, sport or gaming
# footage, which is what this is actually used for, so every run starts from
# footage the user uploaded and holds the rights to.
ENABLED_SOURCES=upload

# ---- The YouTube source (off, and deliberately awkward to switch on) -------
# There IS a working YouTube adapter. It finds clips from channels, channel
# archive searches and hashtag Shorts tabs, downloads them with yt-dlp, and
# pulls their auto-captions for the burned-in subtitles and the music scan.
#
# It is not licensed for reuse, so it takes BOTH of these to use it:
#   1. add "youtube" to ENABLED_SOURCES (and to a niche's Sources setting)
#   2. set ALLOW_UNLICENSED_SOURCES=true
#
# What you are accepting by doing that:
#   - downloading breaks YouTube's Terms of Service
#   - Content ID matches the content regardless of who re-uploaded it, so
#     claims are likely on anything from a broadcaster
#   - as a paid service, that liability is yours rather than your subscribers'
#
# For one person publishing to their own channel and accepting claims, this is
# the same trade every tool in this category makes. For a subscription product
# it is a business decision, not a technical one. It stays off by default.
ALLOW_UNLICENSED_SOURCES=false

# YouTube serves a bot interstitial to datacentre IPs. Without cookies a
# server-hosted instance gets nothing back even though the same code works on
# your laptop, and every run fails with "no clips". Pick ONE of these three.
#
#   1. YTDLP_COOKIES_CONTENT - paste the whole cookies.txt in as one value.
#      Use this on Railway, Fly, Render and anywhere else with no volume to
#      put a file on. Escaped 
 between lines is fine.
#   2. YTDLP_COOKIES_FILE - a path, when you do have a volume or a local file.
#   3. YTDLP_COOKIES_FROM_BROWSER - chrome, firefox, edge, brave. Desktop only;
#      a container has no browser to read.
#
# Export cookies.txt from a signed-in YouTube tab with any "Get cookies.txt"
# browser extension. Treat the value as a password: it is a live session.
YTDLP_COOKIES_CONTENT=
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

# ---- Making the YouTube source survive a datacentre ------------------------
# None of this is ever seen by a subscriber. It is the operator absorbing the
# awkwardness so the person paying just presses Publish.
#
# Player clients are tried in order until one answers. Which ones YouTube
# accepts changes without notice, so a dead client costs a retry rather than
# the whole feature. "default" means yt-dlp's own chain.
YTDLP_PLAYER_CLIENTS=default,android,web_safari,tv
#
# The real fix for datacentre blocking: route yt-dlp through a residential
# proxy so YouTube sees a home IP. Format is the usual proxy URL, either
# http://user:pass@host:port or socks5://user:pass@host:port
YTDLP_PROXY=
#
# Only the metadata requests go through it by default, and that is deliberate.
# The block lands on the page and API calls, which are kilobytes each. The
# video itself comes off a CDN that does not care about the IP. Measured
# against these plans, proxying the downloads too costs roughly $65 a month per
# Pro subscriber against about $50 of revenue, so it is off unless you have a
# reason. Discovery-only traffic is a few MB a month.
YTDLP_PROXY_DOWNLOADS=false
#
# yt-dlp asks for a JavaScript runtime. The image does not ship one: deno was
# measured against the failing player clients and changed nothing, so it was
# not worth the image size. Set this only if you install one yourself.
YTDLP_JS_RUNTIME=

# The format selector, identical to the desktop tool's. The middle branch is
# the one that matters: without an any-extension merge fallback, a player
# client that offers no mp4 pair drops straight to a single muxed stream.
YTDLP_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/bestvideo+bestaudio/best
YTDLP_SOCKET_TIMEOUT=30

# ---- Media -----------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MAX_UPLOAD_MB=512
RENDER_WORKERS=2

# ---- AI (optional; used for titles and clip labels) ------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ---- YouTube publishing ----------------------------------------------------
# A **Web application** OAuth client from Google Cloud, with the YouTube Data
# API v3 enabled. Add GOOGLE_REDIRECT_URI to the client's authorised redirect
# URIs exactly as written here. Without these the app still runs: videos render
# and download, and the Home screen shows publishing as off.
#
# Note the quota: a new Google Cloud project gets 10,000 units/day and each
# upload costs 1,600, so roughly 6 uploads a day across ALL your users until
# you apply for an increase. Plan for that before you sell subscriptions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# ---- Billing ---------------------------------------------------------------
# Without these the app runs fine and everyone stays on the free plan.
# Create two recurring prices in Stripe, then set their IDs here.
# 1. Secret key from the Stripe dashboard (sk_test_... while testing).
STRIPE_SECRET_KEY=
# 2. Two RECURRING MONTHLY prices you create in Stripe. These are price IDs
#    (price_...), not product IDs.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# 3. Signing secret (whsec_...) of a webhook endpoint pointed at
#    https://yourdomain/api/billing/webhook and subscribed to
#    customer.subscription.created / .updated / .deleted.
#    A plan is ONLY ever changed by this webhook, never by the browser redirect.
STRIPE_WEBHOOK_SECRET=

# What the pricing screen displays. Labels only -- the amount actually charged
# is whatever the Stripe Price says, so keep these in step with it or a
# customer will see one number and be charged another.
PRICE_LABEL_STARTER=$12/mo
PRICE_LABEL_PRO=$39/mo
