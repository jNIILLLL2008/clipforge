# ClipForge render agent.
#
# You should not need this file. Run the agent with no arguments and it writes
# one for you: it opens your browser, you click one button, and the token lands
# here without ever being shown to you or typed by you.
#
# This example is for the cases where that cannot happen -- a machine with no
# browser, or an unattended install. Both settings have defaults: the server is
# the hosted service, and the token comes from pairing.
#CLIPFORGE_SERVER=https://clipforge-production-8f29.up.railway.app
#CLIPFORGE_AGENT_TOKEN=

# Your own footage. Drop clips in here and niches that use "upload" will find
# them. Nothing is sent anywhere until a finished video goes back to the server.
CLIPFORGE_FOOTAGE_DIR=./footage

# Scratch space for renders in progress. Cleaned up as it goes.
CLIPFORGE_WORK_DIR=./work

# How long to wait before asking for work again: after a job, and when idle.
CLIPFORGE_POLL_SECONDS=5
CLIPFORGE_IDLE_SECONDS=20
