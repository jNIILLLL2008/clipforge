# Secrets. Never commit this: it holds the Stripe key, the Google client
# secret and the token-signing key.
.env

# Local database and media
*.db
*.sqlite3
storage/

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Editors / OS
.DS_Store
Thumbs.db

# Generated production env block - contains live secrets
railway-env.txt

# Render agent. agent.env holds a live agent token, and the footage and work
# folders are the subscriber's own video.
agent/agent.env
agent/footage/
agent/work/
# Downloaded or unpacked beside the agent, ~200MB of third-party binaries.
agent/ffmpeg/
# Build artefacts from agent/build_exe.py. The .exe is 24MB and is rebuilt
# from the spec, so it is released rather than committed.
agent/ClipForgeAgent.exe
agent/ClipForgeAgent-windows.zip
# The unpacked bundle. It carries ~200MB of ffmpeg AND the agent.env
# a test run pairs into it, which is a live credential.
agent/ClipForgeAgent-windows/
# Any agent.env anywhere, not just the one beside the source. This is
# the pattern that matters: the file is written by pairing, so it
# appears wherever somebody unpacks and runs the agent.
**/agent.env
build/
dist/
*.spec.bak
